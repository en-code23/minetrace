{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "publisher": "MineTrace contributors",
    "copyright": "Copyright © 2026 MineTrace contributors",
    "useLocalToolsDir": true,
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "upgradeCode": "54313206-ba74-5d93-9723-1d3efb3ffc44",
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
